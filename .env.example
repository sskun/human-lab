# .env 配置模板：真实值放 .env（已被 .gitignore 排除，不会提交）。
# 新环境/换机器时：复制本文件为 .env，再填入真实值。
# 密钥泄露风险提示：API Key 不要出现在任何 git 提交、截图、聊天记录里。

# 百炼 API Key（北京地域）
DASHSCOPE_API_KEY=sk-填入你的APIKey

# DashScope WebSocket 推理入口（专属端点，wss）
DASHSCOPE_WS_URL=wss://<专属实例ID>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference

# TTS 配置（format: mp3|wav|pcm|opus）
# 音色列表（qwen-audio-3.0-tts-plus 仅 2 个系统音色，见官方文档 qwen-audio-tts-voice-list）：
#   longanlingxin = 龙安灵心（女）  longanlufeng = 龙安鲁风（男）
TTS_MODEL=qwen-audio-3.0-tts-plus
TTS_VOICE=longanlingxin
TTS_FORMAT=mp3
TTS_SAMPLE_RATE=22050

# 后端端口（apps/server）
PORT=3001

# ASR 配置（语音识别：语音 → 文字，docs/asr-design.md）
ASR_MODEL=qwen-audio-3.1-asr-flash
# HTTP 推理端点（与 TTS 同一专属实例）
DASHSCOPE_ASR_URL=https://<专属实例ID>.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 单次识别超时（毫秒，可选）
# ASR_TIMEOUT_MS=120000

# LLM 配置（对话/回复）
LLM_MODEL=qwen3.8-flash
# OpenAI 兼容模式根地址（专属实例）
LLM_BASE_URL=https://<专属实例ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 单次对话超时（毫秒，可选）
# LLM_TIMEOUT_MS=120000

# 实时聊天数字人 system 人设（可选，不配用默认"数字人小泡泡"人设）
# LLM_SYSTEM=你是数字人小安。用口语化中文对话，回复简短。

# ———— 口播数字人（wan3.0，设计见 docs/lipsync-design.md；能力实现时启用）————
# TALK_MODEL=wan3.0-video-prime
# TALK_RESOLUTION=480P
# TALK_RATIO=9:16
# TALK_DURATION=-1
# TALK_PROMPT_EXTEND=false
# TALK_POLL_INTERVAL_MS=15000
# TALK_TIMEOUT_MS=600000
# LIPSYNC_TEXT_MAX_CHARS=60
# AVATAR_DIR=assets/avatars
# AVATAR_ID=default
